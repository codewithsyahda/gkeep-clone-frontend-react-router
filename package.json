{
  "name": "gkeep-clone-frontend-react-router",
  "description": "A note-taking front-end application personal project. Inspired by Google Keep.",
  "author": {
    "name": "Syahda Romansyah",
    "email": "codewithsyahda@gmail.com"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env IS_RR7=true react-router build",
    "dev": "cross-env IS_RR7=true react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint .",
    "format:c": "prettier -c .",
    "format:w": "prettier -w .",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "react-router typegen && tsc",
    "prepare": "husky || true",
    "sb": "storybook dev -p 6006",
    "sb:build": "storybook build"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.11.0",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@mui/material": "^7.3.7",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@tanstack/react-query": "^5.90.21",
    "@tiptap/core": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/static-renderer": "^3.23.6",
    "axios": "^1.13.6",
    "better-auth": "^1.5.0",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "focus-trap-react": "^12.0.3",
    "isbot": "^5.1.32",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.71.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-router": "^7.12.0",
    "sonner": "^2.0.7",
    "use-debounce": "^10.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.0",
    "@react-router/dev": "^7.12.0",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/react-vite": "^10.3.3",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.3.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.10",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.61.0",
    "prettier": "3.7.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "storybook": "^10.3.3",
    "storybook-addon-remix-react-router": "^6.1.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
